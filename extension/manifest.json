{
	"manifest_version": 3,
	"name": "Starteammate remote-debugging",
	"version": "1.0.0",
	"description": "Lets Starteammate Desktop work in your own browser tabs without Chrome's remote debugging prompt. Talks only to 127.0.0.1.",
	"key": "",
	"minimum_chrome_version": "125",
	"background": { "service_worker": "background.js" },
	"permissions": ["debugger", "tabs", "alarms", "storage"],
	"action": { "default_title": "Starteammate remote-debugging", "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
	"icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
